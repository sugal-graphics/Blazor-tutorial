@page "/"
@rendermode InteractiveServer
<PageTitle>Home</PageTitle>

<h1>Bind use</h1>
<input @bind="name" placeholder="Enter your name"/>
<button @onclick="greet">Enter</button>
<p>@message</p>

@code{
    string name="";
    string message="";
    void greet()
    { 
        if(string.IsNullOrWhiteSpace(name)) 
        {
            message="Please Enter a name";
        }
        else{
            message=$"Hello {name}";
        }
        
    }
}
